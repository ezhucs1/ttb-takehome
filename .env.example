# Which extractor runs: claude | tesseract | demo. Leave blank to pick claude when a key is set, else demo.
LABELVERIFY_EXTRACTOR=
# Required for the claude extractor
ANTHROPIC_API_KEY=
# Model used for label extraction (swap to claude-haiku-4-5 if latency measures over budget)
LABELVERIFY_MODEL=claude-opus-5-5
# Hard timeout for a single extraction call, in seconds
LABELVERIFY_EXTRACT_TIMEOUT=20
