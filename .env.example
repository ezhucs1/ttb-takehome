# Copy to .env. Every value is optional; the app runs in demo mode with none of them.

# Enables the vision extractor and the model rewrite of correction notices.
ANTHROPIC_API_KEY=

# Google Gemini alternative (free tier works). Used when set and no Anthropic key is present.
GEMINI_API_KEY=
# Leave blank to pick the newest stable Flash model automatically (model names get retired).
LABELVERIFY_GEMINI_MODEL=

# Which extractor runs: claude | gemini | tesseract | demo.
# Blank picks claude if ANTHROPIC_API_KEY is set, else gemini if GEMINI_API_KEY is set, else demo.
LABELVERIFY_EXTRACTOR=

# Extraction model. Measured on the angled-photo sample: sonnet 4.1 s, opus 6.0 s (both correct).
# claude-haiku-4-5 is faster still; use it if its reads are correct on your labels.
LABELVERIFY_MODEL=claude-sonnet-5-5

# Who rewrites correction notices in plain language: gemini | claude | template.
# Blank picks gemini if GEMINI_API_KEY is set (free, not latency-bound), else claude, else template.
LABELVERIFY_NOTICE_PROVIDER=
# Claude model for that rewrite when the provider is claude.
LABELVERIFY_NOTICE_MODEL=claude-opus-5-5

# Public-deployment guards. Hide the demo account list on the landing page (reviewers use
# the README) and cap paid model reads per UTC day; 0 or blank means unlimited.
LABELVERIFY_DEMO_ACCOUNTS=true
# true behind HTTPS only: the session cookie is then never sent over plain http.
LABELVERIFY_SECURE_COOKIES=false
LABELVERIFY_DAILY_READ_LIMIT=
# Link shown on the landing page.
LABELVERIFY_REPO_URL=https://github.com/ezhucs1/ttb-takehome

# Hard timeout for a single extraction call, in seconds.
LABELVERIFY_EXTRACT_TIMEOUT=20

# Long edge of the image sent to the model, in pixels. Smaller is faster; 1200 is a good test.
LABELVERIFY_IMAGE_MAX_EDGE=1500
# true = schema-constrained replies (slow first call after any schema change); default off.
LABELVERIFY_STRUCTURED_OUTPUT=false

# SQLAlchemy URL. SQLite by default; a Postgres URL works unchanged.
DATABASE_URL=sqlite:///./data/labelverify.db

# Signs session cookies. Blank is fine locally: a key is generated once and kept beside the
# database (data/.secret_key), so sessions survive restarts. Set it explicitly in any shared
# deployment: openssl rand -hex 32
SECRET_KEY=
