# Copy to .env. Every value is optional; the app runs in demo mode with none of them.

# Enables the vision extractor and the model rewrite of correction notices.
ANTHROPIC_API_KEY=

# Which extractor runs: claude | tesseract | demo. Blank picks claude when a key is set, else demo.
LABELVERIFY_EXTRACTOR=

# Extraction model. Swap to claude-haiku-4-5 if measured latency is over the 5-second budget.
LABELVERIFY_MODEL=claude-opus-5-5

# Model that rewrites correction notices in plain language (template is used without a key).
LABELVERIFY_NOTICE_MODEL=claude-opus-5-5

# Hard timeout for a single extraction call, in seconds.
LABELVERIFY_EXTRACT_TIMEOUT=20

# SQLAlchemy URL. SQLite by default; a Postgres URL works unchanged.
DATABASE_URL=sqlite:///./data/labelverify.db

# Signs session cookies. Generate one: openssl rand -hex 32. Random per process if blank.
SECRET_KEY=
